{
  "name": "dida-todo",
  "version": "0.9.1",
  "private": true,
  "type": "module",
  "main": "./dsh-plugin/index.mjs",
  "exports": {
    ".": "./dsh-plugin/index.mjs",
    "./package.json": "./package.json",
    "./locale/*.json": "./dsh-plugin/locale/*.json",
    "./cordis.patch.yml": "./dsh-plugin/cordis.patch.yml"
  },
  "description": "Pi / dsh 扩展：以滴答清单为 Todo 真源，支持自然语言执行、双向同步、提醒、强制人类验收闭环，以及 dsh 会话中断自动续跑。",
  "license": "MIT",
  "author": "Ztllll",
  "homepage": "https://github.com/ztllll/dida-todo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ztllll/dida-todo.git"
  },
  "bugs": {
    "url": "https://github.com/ztllll/dida-todo/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "dida",
    "dida365",
    "todo",
    "task-management",
    "human-in-the-loop",
    "dsh",
    "deepseek-harness",
    "dsh-plugin"
  ],
  "files": [
    "extensions/dida-todo",
    "extensions/dsh",
    "dsh-plugin",
    "scripts/build-dsh.mjs",
    "README.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "bash scripts/check-structure.sh && npm run typecheck && npm test && npm run build:dsh && npm run pack:check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pack:check": "npm pack --dry-run --json >/tmp/dida-todo-pack.json",
    "build:dsh": "node scripts/build-dsh.mjs",
    "pack:dsh": "npm run build:dsh && mkdir -p dist && npm pack --pack-destination dist >/dev/null && ls dist/dida-todo-*.tgz"
  },
  "pi": {
    "extensions": [
      "./extensions/dida-todo"
    ]
  },
  "dependencies": {
    "@suibiji/dida-cli": "^0.1.14",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.1",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@earendil-works/pi-tui": "^0.84.1",
    "@types/node": "^22.20.1",
    "esbuild": "^0.28.2",
    "typebox": "^1.3.11",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh-plugin/cordis.patch.yml"
    }
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  }
}
