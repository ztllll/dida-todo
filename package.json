{
  "name": "dida-todo",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "OMP Agent 扩展：以滴答清单为跨会话任务真源，支持自然语言执行、双向同步、提醒和强制人类验收闭环。",
  "license": "MIT",
  "author": "Ztllll",
  "homepage": "https://github.com/ztllll/dida-todo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ztllll/dida-todo.git"
  },
  "bugs": {
    "url": "https://github.com/ztllll/dida-todo/issues"
  },
  "keywords": [
    "omp-plugin",
    "omp-extension",
    "dida",
    "dida365",
    "todo",
    "task-management",
    "human-in-the-loop"
  ],
  "files": [
    "extensions/dida-todo",
    "docs/adr",
    "docs/development",
    "docs/operations",
    "docs/research",
    "README.md",
    "CHANGELOG.md",
    "CONTEXT.md",
    "DEVELOPMENT.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "bash scripts/check-structure.sh && npm run typecheck && npm test && npm run pack:check",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "pack:check": "npm pack --dry-run --json >/tmp/dida-todo-pack.json"
  },
  "omp": {
    "extensions": [
      "./extensions/dida-todo"
    ]
  },
  "dependencies": {
    "@suibiji/dida-cli": "^0.1.12"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": ">=17.3.3 <18",
    "@oh-my-pi/pi-tui": ">=17.3.3 <18"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "17.3.3",
    "@oh-my-pi/pi-tui": "17.3.3",
    "@types/bun": "1.3.14",
    "@types/node": "^22.20.1",
    "bun": "1.3.14",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.3.14"
  }
}
