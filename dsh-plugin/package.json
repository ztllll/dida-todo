{
  "name": "dida-todo-dsh",
  "version": "0.9.0",
  "description": "滴答清单 Todo + 会话中断自动续跑：Agent 的任务清单同步到滴答（手机可看），content_filter / 429 / 崩溃中断后自动继续，用尽次数后在滴答提醒你。",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@suibiji/dida-cli": "^0.1.14"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "dida365",
    "todo",
    "auto-continue"
  ],
  "license": "MIT",
  "author": "Ztllll",
  "homepage": "https://github.com/ztllll/dida-todo#dsh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ztllll/dida-todo.git",
    "directory": "dsh-plugin"
  },
  "engines": {
    "node": ">=20"
  }
}
